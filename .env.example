# OnCall Rehearsal Agent — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# REQUIRED — App refuses to start without these
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SECRET_KEY=your_secret_key_here_must_be_at_least_32_characters_long

# OPTIONAL — Defaults shown
CLAUDE_MODEL=claude-sonnet-5-5
PRODUCTION=false
DATABASE_URL=sqlite:///./oncall.db
CORS_ORIGIN=http://localhost:8000
LOG_LEVEL=INFO
